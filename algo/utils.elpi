namespace derive.algo-utils {

func names12 name -> name, name.
names12 N N1 N2 :- !,
  coq.name-suffix N 1 N1, coq.name-suffix N 2 N2.

pred name-prefix i: name, i:string, o:name.
name-prefix N P R :-
  coq.name->id N NS,
  S is P ^ NS,
  coq.string->name S R.

% given TyParam ArgNo and T, 
% duplicate-argument skips TyParam products, 
% then for the first ArgNo products adds another product expecting an argument of the same Type, 
% after all lambdas are processed returns the body unchanged
pred duplicate-arguments i:int, i:int, i:term, o:term.
duplicate-arguments 0 0 T T :- !.
duplicate-arguments 0 O (prod N TyA T) (prod Arg1 TyA a1\ (prod Arg2 TyA a2\ (S a1 a2))) :- 
    O > 0,
    P is O - 1,
    names12 N Arg1 Arg2,
    (pi a1 a2\ duplicate-arguments 0 P (T a1) (S a1 a2)).
duplicate-arguments N O (prod TyName TyArg T) (prod TyName TyArg S) :- !,
  N > 0,
  M is N - 1,
  pi a1\ duplicate-arguments M O (T a1) (S a1).

pred count-args i:int, i:term, o:int.
count-args N T R :-
  coq.count-prods T M,
  R is M - N.
}