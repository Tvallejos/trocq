shorten derive.common-algo.{mk-mR-type-swap}.
shorten derive.algo-utils.{ type-of-args}.

namespace derive.swap {

pred whds i:term, o:term.
whds T R :-
  whd T [] HD ARGS,
  unwind HD ARGS R.
    
% Ksource, Kdest, remaining args, number of type args, KRTy, Type of args Ksource, Type of args KDest, Goal,
pred process-args i:term, i:term, i:term, i:int, i:int, i:term, i:term, i:list term, i:list term, i:term, o:term.
process-args Ksrc Kdest KR 0 TyArgsNo KTyR Goal TySrc TyDest ITyTy R:- 
  R = KR. 
process-args Ksrc Kdest KR N TyArgsNo (prod AN1 A1Ty a1\ prod AN2 A2Ty a2\ prod ARN (ARTy a1 a2) ar\ (Bo a1 a2 ar)) Goal TySrc TyDest ITyTy 
                                   (fun AN1 A1Ty a1\ fun AN2 A2Ty a2\ fun ARN (ARTy a1 a2) ar\ (RF a1 a2 ar)):- 
  M is N - 1,
  @pi-decl AN1 A1Ty a1\
  @pi-decl AN2 A2Ty a2\
  @pi-decl ARN (ARTy a1 a2) ar\
    coq.mk-app Ksrc [a1] (NewKS a1),
    coq.mk-app Kdest [a2] (NewKD a2),
    whd A1Ty _ A1Ind _, %TODO: fixme for inductives with type parameters, assemble swap
    swap-db A1Ind SwapC,
    coq.mk-app SwapC [a1,a2,ar] (RA a1 a2 ar), 
    coq.mk-app KR [a2,a1,(RA a1 a2 ar)] (NewKR a1 a2 ar),
    (param a2 a1 ar =!=>
    % TODO: process args a2 a1 for KR
    process-args (NewKS a1) (NewKD a2) (NewKR a1 a2 ar) M TyArgsNo (Bo a1 a2 ar) Goal TySrc TyDest ITyTy (R a1 a2 ar)),
    % if the type of the argument is an instance of the inductive type add an induction hypothesis
    whd ITyTy _ Ind _,
    whd A2Ty _ IndD _,
    if (Ind = IndD)
       (coq.mk-app Goal [a1, a2, ar] (EqTy a1 a2 ar),
        (RF a1 a2 ar) = fun `e` (EqTy a1 a2 ar) e\ (R a1 a2 ar))
        (RF = R).

% invariant: all type arguments were already processed. 
% Constructor src, Constructor dest, Constructor R, Constructor dest Type, No of Arguments to process, 
% constructorR Type, type of i2, something of type : i1 i2 iR => goal. 
pred mkBranch i:term, i:term, i:term, i:int, i:term, i:term, i:term, o:term.
mkBranch KS KD KR N KTyR ITyTy Goal Eq:-
  type-of-args KTyR N SrcArgs DestArgs,
  whd ITyTy [] _ TyArgs,
  process-args KS KD KR N {std.length TyArgs} KTyR Goal SrcArgs DestArgs ITyTy Eq.

pred mkBranches i:list term, i:list term, i:list term, i:list term, i:list term, i:term, i:term o:list term.
mkBranches [] [] [] [] [] _ _ [].
mkBranches [KS|KsS] [KD|KsD] [KR|KRs][KTy|KTys] [KTyR|KTyRs] ITyTy Goal [R|Rs] :-
  mkBranch KS KD KR {coq.count-prods KTy} KTyR ITyTy Goal R,
  mkBranches KsS KsD KRs KTys KTyRs ITyTy Goal Rs.

pred implement-swap i:int, i:int, i:term, i:list term, i:list term, i:list term, i:list term, i:list term, i:term, i:term, o:term.
% Pred comes with Type parameters applied 
% RInd comes with Type parameters applied 
implement-swap 0 _TyParamNo (prod IN1 ITy1 i1\ prod IN2 ITy2 i2\ prod ARN (ARTy i1 i2) ar\ (Bo i1 i2 ar)) KsS KsD KRs KTys KTyRs Pred RInd
            (fix `f` 2 RT f\ fun IN1 ITy1 i1\ fun IN2 ITy2 i2\ fun ARN (ARTy i1 i2) ar\ (R f i1 i2 ar)) :-
  coq.safe-dest-app ITy1 Ind _, 
  Ind = (global (indt GR)),
  coq.env.recursive? GR, !,
  RT = (prod IN1 ITy1 i1\ prod IN2 ITy2 i2\ prod ARN (ARTy i1 i2) ar\ (Bo i1 i2 ar)),
  coq.mk-app RInd [Pred] RIndP,
  @pi-decl `f` RT f\
  @pi-decl IN1 ITy1 i1\
  @pi-decl IN2 ITy2 i2\
  @pi-decl ARN (ARTy i1 i2) ar\
    (swap-db Ind f => 
      mkBranches KsS KsD KRs KTys KTyRs ITy2 Pred (Brs f)),
    std.append (Brs f) [i1,i2,ar] (IndArgs f i1 i2 ar),
    coq.mk-app RIndP (IndArgs f i1 i2 ar) (R f i1 i2 ar).
implement-swap 0 _TyParamNo (prod IN1 ITy1 i1\ prod IN2 ITy2 i2\ prod ARN (ARTy i1 i2) _) KsS KsD KRs KTys KTyRs Pred RInd
            (fun IN1 ITy1 i1\ fun IN2 ITy2 i2\ fun ARN (ARTy i1 i2) ar\ (R i1 i2 ar)) :-
  coq.mk-app RInd [Pred] RIndP,
  @pi-decl IN1 ITy1 i1\
  @pi-decl IN2 ITy2 i2\
  @pi-decl ARN (ARTy i1 i2) ar\
    mkBranches KsS KsD KRs KTys KTyRs ITy2 Pred Brs,
    std.append Brs [i1,i2,ar] (IndArgs i1 i2 ar),
    coq.mk-app RIndP (IndArgs i1 i2 ar) (R i1 i2 ar).
implement-swap N TyParamNo (prod AN1 ATy1 a1\ prod AN2 ATy2 a2\ prod ARN (ARTy a1 a2) ar\ (Bo a1 a2 ar)) KsS KsD KRs KTys KTyRs Pred RInd
            (fun AN1 ATy1 a1\ fun AN2 ATy2 a2\ fun ARN (ARTy a1 a2) ar\ (R a1 a2 ar)) :-
  M is N - 1,
  @pi-decl AN1 ATy1 a1\ %A1 : Type
  @pi-decl AN2 ATy2 a2\ %A2 : Type
  @pi-decl ARN (ARTy a1 a2) ar\ % AR : Param00.Rel A1 A2
    coq.mk-app Pred [a1,a2,ar] (NewPred a1 a2 ar),
    
    (ARType a1 a2) = {{ lp:a1 -> lp:a2 -> Type }},
    coq.elaborate-skeleton ar (ARType a1 a2) (RelAR a1 a2 ar) ok,
    coq.elaborate-skeleton {{ sym_rel lp:{{ RelAR a1 a2 ar }} }} (ARType a2 a1) (RelRA a1 a2 ar) ok,

    coq.mk-app RInd [a1,a2,ar] (NewRIndSkel a1 a2 ar),
    coq.elaborate-skeleton (NewRIndSkel a1 a2 ar) _ (NewRInd a1 a2 ar) ok,

    std.map KsS (x\ r\ sigma TMP\ coq.mk-app x [a1] TMP, r = TMP) (NewKsS a1),
    std.map KsD (x\ r\ sigma TMP\ coq.mk-app x [a2] TMP, r = TMP) (NewKsD a2),
    std.map KRs (x\ r\ sigma TMP\ coq.mk-app x [a2,a1, (RelRA a1 a2 ar)] TMP, r = TMP) (NewKRs a1 a2 ar),

    std.map KTys (x\ r\ sigma TMP\ coq.subst-prod [a2] x TMP, r = TMP) (NewKTys a2),
    std.map KTyRs (x\ r\ sigma TMP1\ coq.subst-prod [a1,a2,(RelAR a1 a2 ar)] x TMP1, r = TMP1) (NewKTyRs a1 a2 ar),
    Sym = {{ @sym_rel }},
    coq.mk-app Sym [a1, a2, ar] (SymApp a1 a2 ar),
    (SymFun a1 a2 ar) = {{ fun (a1 : lp:{{ATy1}}) (a2 : lp:{{ATy2}}) (ar : lp:{{SymApp a1 a2 ar}})=> ar }},
    %coq.elaborate-skeleton (RMS a1 a2 ar) _ (RM a1 a2 ar) ok,
    swap-db a1 (SymFun a1 a2 ar) ==>
    %swap-db a1 (SymApp a1 a2 ar) ==>
    implement-swap M TyParamNo (Bo a1 a2 ar) (NewKsS a1) (NewKsD a2) (NewKRs a1 a2 ar) (NewKTys a2) (NewKTyRs a1 a2 ar) (NewPred a1 a2 ar) (NewRInd a1 a2 ar) (R a1 a2 ar).


func main inductive, string -> list prop.
main GR Prefix Clauses :- std.do! [

  coq.env.indt GR _ TyParamNo _ _ KNs KTys,
  Ind = (global (indt GR)),
  std.assert! (param Ind Ind TR) "derive.swap: use derive.param2 before",
  % param Ind Ind TR,
  coq.typecheck TR TRTy _,
  % mymap-def Ind IndMap,
  mk-mR-type-swap TyParamNo TRTy IndMap {{ Type }} TR MRTy,
  std.assert-ok! (coq.elaborate-skeleton MRTy _ MRTyE) "derive.swap generates illtyped type",
  TR = global (indt GRR),
  coq.gref->id (indt GRR) Rname,
  RInductionName is Rname ^ "_rect",
  coq.locate RInductionName RInd,
  coq.prod->fun MRTyE Pred,
  coq.env.indt GRR _ _ _ _ KRNs KTyRs,
  std.map KNs (x\ r\ r = (global (indc x))) Ks,
  std.map KRNs (x\ r\ r = (global (indc x))) KRs,
  implement-swap TyParamNo TyParamNo MRTyE Ks Ks KRs KTys KTyRs Pred (global RInd) R,
  std.assert-ok! (coq.elaborate-skeleton R MRTyE Re) "derive.swap generates illtyped term",
  Name is Prefix ^ "swap",
  coq.ensure-fresh-global-id Name FName,
  coq.env.add-const FName Re MRTyE _ C,
  I = global (indt GR),
  Clauses = [swap-done GR, swap-db I (global (const C))],
  std.forall Clauses (x\
    coq.elpi.accumulate _ "derive.swap.db" (clause _ _ x)
  ),
].

}